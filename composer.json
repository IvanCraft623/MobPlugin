{
    "name": "ivancraft623/mobplugin",
    "description": "Plugin for PocketMine-MP that implements mobs AI.",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2",
        "ivancraft623/pathfinder": "dev-main",
        "inxomnyaa/apibossbar": "dev-pm5",
        "bstats/pocketmine-mp": "^1.0.0"
    },
    "require-dev": {
        "pocketmine/pocketmine-mp": "^5.42.2",
        "phpstan/phpstan": "2.1.46",
        "phpunit/phpunit": "^10.5",
        "sof3/pharynx": "^0.3.8",
        "justinrainbow/json-schema": "^6.10.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/IvanCraft623/Pahtfinder.git"
        }
    ],
    "autoload": {
        "psr-0": {
            "IvanCraft623\\MobPlugin\\": "src"
        }
    },
    "autoload-dev": {
        "psr-0": {
            "IvanCraft623\\MobPlugin\\": "tests/phpunit"
        }
    },
    "scripts": {
        "build": "php -dphar.readonly=0 vendor/bin/pharynx -i=. -c -p=MobPlugin.phar",
        "compile-spawn-rules": "php tools/spawn-rules/compile.php",
        "test": "vendor/bin/phpunit --bootstrap vendor/autoload.php --fail-on-warning --no-progress tests/phpunit"
    }
}
