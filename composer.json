{
    "name": "ivancraft623/mobplugin",
    "description": "Plugin for PocketMine-MP that implements mobs AI.",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2",
        "ivancraft623/pathfinder": "dev-main",
        "inxomnyaa/apibossbar": "dev-pm5",
        "bstats/pocketmine-mp": "^1.0.0"
    },
    "require-dev": {
        "pocketmine/pocketmine-mp": "^5.42.2",
        "phpstan/phpstan": "2.2.16",
        "phpunit/phpunit": "^10.5",
        "sof3/pharynx": "^0.3.8",
        "justinrainbow/json-schema": "^6.10.0",
        "mojang/bedrock-samples": "1.21.50"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/IvanCraft623/Pahtfinder.git"
        },
        {
            "type": "package",
            "package": {
                "name": "mojang/bedrock-samples",
                "version": "1.21.50",
                "type": "metadata",
                "description": "Mojang bedrock-samples spawn rules and JSON schemas (dev-only). The version is the pinned spawn schema version.",
                "dist": {
                    "url": "https://github.com/Mojang/bedrock-samples/archive/46ba6ea985fb5a92d79a9419198f10dda14c199d.zip",
                    "type": "zip",
                    "reference": "46ba6ea985fb5a92d79a9419198f10dda14c199d"
                },
                "source": {
                    "url": "https://github.com/Mojang/bedrock-samples.git",
                    "type": "git",
                    "reference": "46ba6ea985fb5a92d79a9419198f10dda14c199d"
                }
            }
        }
    ],
    "autoload": {
        "psr-0": {
            "IvanCraft623\\MobPlugin\\": "src"
        }
    },
    "autoload-dev": {
        "psr-0": {
            "IvanCraft623\\MobPlugin\\": "tests/phpunit"
        }
    },
    "scripts": {
        "build": "php -dphar.readonly=0 vendor/bin/pharynx -i=. -c -p=MobPlugin.phar",
        "compile-spawn-rules": "php tools/spawn-rules/compile.php",
        "generate-entity-data": "php tools/entity-data/generate-entity-data.php",
        "generate-spawn-schema": "php tools/spawn-rules/generate-schema.php",
        "test": "vendor/bin/phpunit --bootstrap vendor/autoload.php --fail-on-warning --no-progress tests/phpunit"
    }
}
